{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/cadgen-setup.ps1\"",
            "timeout": 600,
            "statusMessage": "Getting cadgen and the CAD Viewer ready"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/cadgen-stop.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
